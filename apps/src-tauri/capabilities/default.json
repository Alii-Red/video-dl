{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main app window — local (bundled/dev-server) content only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-resizable",
    "core:window:allow-set-focus",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-center",
    "core:window:allow-is-minimized",
    "allow-probe-url",
    "allow-extract-from-page",
    "allow-open-interactive-extraction",
    "allow-start-download",
    "allow-resolve-playlist",
    "allow-start-playlist-download",
    "allow-cancel-download",
    "allow-pause-download",
    "allow-resume-download",
    "allow-list-active",
    "allow-list-history",
    "allow-remove-download",
    "allow-retry-download",
    "allow-delete-history-entry",
    "allow-open-containing-folder",
    "allow-open-download-folder",
    "allow-rescan-extension",
    "allow-extension-connected",
    "allow-ffmpeg-is-full",
    "notification:default",
    "allow-get-settings",
    "allow-update-settings",
    "allow-update-ytdlp"
  ]
}
