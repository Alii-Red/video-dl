{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video DL",
  "version": "0.1.0",
  "identifier": "com.local.videodl",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [{ "title": "Video DL", "width": 1100, "height": 720 }],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "binaries/yt-dlp-x86_64-pc-windows-msvc.exe": "binaries/yt-dlp-x86_64-pc-windows-msvc.exe",
      "binaries/ffmpeg.exe": "binaries/ffmpeg.exe",
      "binaries/deno.exe": "binaries/deno.exe",
      "../extension": "extension"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
